{
    "name": "edwinpeligro85/laravel-shipping-cost",
    "description": "Este paquete permite calcular y aplicar los costos de envío en una tienda en línea.",
    "keywords": [
        "edwinpeligro85",
        "laravel",
        "laravel-shipping-cost",
        "lshipping-cost"
    ],
    "homepage": "https://github.com/edwinpeligro85/laravel-shipping-cost",
    "license": "MIT",
    "authors": [
        {
            "name": "Edwin Serna",
            "email": "edwinflow88@gmail.com",
            "role": "Full Stack Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "spatie/laravel-package-tools": "^1.14.0",
        "illuminate/contracts": "^10.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^7.9",
        "nunomaduro/larastan": "^2.0.1",
        "orchestra/testbench": "^8.0",
        "pestphp/pest": "^2.0",
        "pestphp/pest-plugin-arch": "^2.0",
        "pestphp/pest-plugin-laravel": "^2.0",
        "phpstan/extension-installer": "^1.1",
        "phpstan/phpstan-deprecation-rules": "^1.0",
        "phpstan/phpstan-phpunit": "^1.0",
        "spatie/laravel-ray": "^1.26"
    },
    "autoload": {
        "psr-4": {
            "Edwinpeligro85\\LaravelShippingCost\\": "src/",
            "Edwinpeligro85\\LaravelShippingCost\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Edwinpeligro85\\LaravelShippingCost\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Edwinpeligro85\\LaravelShippingCost\\LaravelShippingCostServiceProvider"
            ],
            "aliases": {
                "ShippingCost": "Edwinpeligro85\\LaravelShippingCost\\Facades\\ShippingCost"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
